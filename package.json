{
  "name": "techbook-starter-kit",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vivliostyle build",
    "build:print": "vivliostyle build --config vivliostyle.print.config.js --preflight press-ready-local --preflight-option gray-scale",
    "build:docker": "docker run --rm -v \"$PWD:/work\" -v /work/node_modules -w /work node:24-bookworm-slim sh -lc 'sh scripts/setup.sh && npm ci && npx playwright install --with-deps chromium-headless-shell && npm run build && npm run build:print && npm run check:pdf -- output/pdf/book.pdf output/pdf/book_print.pdf'",
    "preview": "vivliostyle preview",
    "test": "node --test scripts/check-pdf.test.mjs",
    "check:pdf": "node scripts/check-pdf.mjs"
  },
  "dependencies": {
    "@mitsuharu/vivliostyle-theme-noto-sans-jp": "0.1.4",
    "@vivliostyle/cli": "11.3.3",
    "@vivliostyle/theme-base": "3.0.0",
    "@vivliostyle/theme-techbook": "3.0.0",
    "press-ready": "4.0.3"
  },
  "devDependencies": {
    "@vivliostyle/vfm": "2.7.2",
    "mermaid-isomorphic": "3.1.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.64.0"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "handlebars": "4.7.10",
    "katex": "0.19.0",
    "prismjs": "1.30.0",
    "trim": "0.0.3",
    "valibot": "1.5.0",
    "press-ready": {
      "uuid": "11.1.1"
    }
  }
}
