{
  "type": "module",
  "name": "techbook-starter-kit",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "vivliostyle build",
    "build:print": "vivliostyle build --config vivliostyle.print.config.js --preflight press-ready-local --preflight-option gray-scale",
    "build:all": "npm run build && npm run build:print && npm run build:epub",
    "build:docker": "docker run --rm --pull=always -v \"$PWD:/work\" -v /work/node_modules -w /work node:24-bookworm-slim sh -lc 'sh scripts/setup.sh && npm ci && npx playwright install --with-deps chromium-headless-shell && npm run build:all && npm run check:pdf -- output/pdf/book.pdf output/pdf/book_print.pdf && npm run check:epub'",
    "preview": "vivliostyle preview",
    "lint": "textlint \"manuscript/**/*.md\"",
    "test": "node --import tsx --test \"scripts/**/*.test.{js,ts}\"",
    "check:pdf": "node --import tsx scripts/pdf/check-pdf.ts",
    "build:epub": "vivliostyle build --config vivliostyle.epub.config.js",
    "check:epub": "node --import tsx scripts/epub/check-epub.ts",
    "prebuild:epub": "node --import tsx scripts/epub/prepare-epub.ts",
    "check:epub:render": "node --import tsx scripts/epub/render-epub.ts",
    "lint:code": "npm run lint:js && npm run lint:shell",
    "lint:js": "eslint scripts --max-warnings=0",
    "lint:shell": "uv run --locked --only-group lint shellcheck --norc scripts/setup.sh scripts/pdf/render-pdf-pages.sh scripts/vrt/run-epub-vrt.sh",
    "test:python": "uv run --locked --no-default-groups python scripts/epub/render-epub-mupdf.test.py",
    "check:epub:mupdf": "uv run --locked --only-group vrt python scripts/epub/render-epub-mupdf.py",
    "test:vrt": "uv run --locked --only-group vrt node --import tsx scripts/vrt/epub-vrt.integration.ts",
    "typecheck": "tsc --project scripts/tsconfig.json"
  },
  "dependencies": {
    "@mitsuharu/vivliostyle-theme-noto-sans-jp": "0.2.0",
    "@vivliostyle/cli": "11.4.0",
    "@vivliostyle/theme-base": "3.0.1",
    "@vivliostyle/theme-techbook": "3.1.0",
    "press-ready": "4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@napi-rs/canvas": "1.1.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@vivliostyle/vfm": "2.7.2",
    "epubjs": "0.3.93",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "hast-util-from-html": "2.0.3",
    "jszip": "3.10.2",
    "mermaid-isomorphic": "3.1.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.65.0",
    "prismjs": "1.30.0",
    "textlint": "15.8.0",
    "textlint-filter-rule-allowlist": "4.0.0",
    "textlint-filter-rule-node-types": "1.1.0",
    "textlint-rule-preset-japanese": "10.0.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "handlebars": "4.7.10",
    "katex": "0.19.0",
    "prismjs": "1.30.0",
    "trim": "0.0.3",
    "valibot": "1.5.0",
    "press-ready": {
      "uuid": "11.1.1"
    },
    "@vivliostyle/cli": {
      "vite": "8.1.6",
      "puppeteer-core": "25.13.0"
    },
    "chromium-bidi": {
      "zod": "4.6.6"
    },
    "@xmldom/xmldom": "0.9.12",
    "glob@>=9 <=14.0.3": "14.0.3",
    "minimatch@>=7 <=11.0.4": "11.0.4"
  }
}
