{
  "type": "module",
  "name": "techbook-starter-kit",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "vivliostyle build",
    "build:print": "vivliostyle build --config vivliostyle.print.config.js --preflight press-ready-local --preflight-option gray-scale",
    "build:all": "npm run build && npm run build:print && npm run build:epub",
    "build:docker": "docker run --rm -v \"$PWD:/work\" -v /work/node_modules -w /work node:24-bookworm-slim sh -lc 'sh scripts/setup.sh && npm ci && npx playwright install --with-deps chromium-headless-shell && npm run build:all && npm run check:pdf -- output/pdf/book.pdf output/pdf/book_print.pdf && npm run check:epub'",
    "preview": "vivliostyle preview",
    "lint": "textlint \"manuscript/**/*.md\"",
    "test": "node --test \"scripts/*.test.js\"",
    "check:pdf": "node scripts/check-pdf.js",
    "build:epub": "vivliostyle build --config vivliostyle.epub.config.js",
    "check:epub": "node scripts/check-epub.js",
    "prebuild:epub": "node scripts/prepare-epub.js",
    "check:epub:render": "node scripts/render-epub.js",
    "lint:code": "node scripts/lint-code.js",
    "test:lint": "node --test scripts/lint-code.integration.js"
  },
  "dependencies": {
    "@mitsuharu/vivliostyle-theme-noto-sans-jp": "0.2.0",
    "@vivliostyle/cli": "11.4.0",
    "@vivliostyle/theme-base": "3.0.1",
    "@vivliostyle/theme-techbook": "3.1.0",
    "press-ready": "4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@napi-rs/canvas": "0.1.69",
    "@resvg/resvg-js": "2.6.2",
    "@vivliostyle/vfm": "2.7.2",
    "epubjs": "0.3.93",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "hast-util-from-html": "1.0.2",
    "jszip": "3.10.1",
    "mermaid-isomorphic": "3.1.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.64.1",
    "prismjs": "1.30.0",
    "textlint": "15.8.0",
    "textlint-filter-rule-allowlist": "4.0.0",
    "textlint-filter-rule-node-types": "1.1.0",
    "textlint-rule-preset-japanese": "10.0.4"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "handlebars": "4.7.10",
    "katex": "0.19.0",
    "prismjs": "1.30.0",
    "trim": "0.0.3",
    "valibot": "1.5.0",
    "press-ready": {
      "uuid": "11.1.1"
    },
    "@vivliostyle/cli": {
      "vite": "8.1.6",
      "puppeteer-core": "25.13.0"
    },
    "chromium-bidi": {
      "zod": "4.6.6"
    },
    "@xmldom/xmldom": "0.9.12"
  }
}
